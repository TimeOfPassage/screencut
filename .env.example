# 服务监听地址
HOST=0.0.0.0
PORT=3000

# 日志级别: debug | info | warn | error | silent
LOG_LEVEL=info

# 逗号分隔的 API Key。留空表示不启用鉴权（仅建议在内网使用）
API_KEYS=

# 同时处理的截图任务上限，超出的请求排队等待
MAX_CONCURRENCY=4

# 单个请求的默认导航超时（毫秒），请求体里可单独覆盖
CAPTURE_TIMEOUT_MS=30000

# 优雅退出时等待中的最长毫秒数
SHUTDOWN_TIMEOUT_MS=10000

# 浏览器选择（三选一，优先级从上到下）：
#   1) BROWSER_EXECUTABLE_PATH -> 直接指定 Chrome 可执行文件
#   2) BROWSER_CHANNEL         -> chrome | chrome-beta | chrome-dev | chrome-canary
#                                 chromium | chromium-headless-shell
#                                 msedge | msedge-beta | msedge-dev | msedge-canary
#   3) 都留空                  -> 依次尝试 chrome、msedge、内置 chromium
BROWSER_EXECUTABLE_PATH=
BROWSER_CHANNEL=chrome

# 是否以无头模式运行
BROWSER_HEADLESS=true

# 在 root 容器中运行时通常需要关闭 sandbox
BROWSER_NO_SANDBOX=false

# 额外的 Chromium 启动参数（逗号分隔）
BROWSER_ARGS=

# 启动浏览器的超时
BROWSER_LAUNCH_TIMEOUT_MS=30000

# 空闲多久后关闭浏览器以释放内存，0 表示常驻不关闭
BROWSER_IDLE_TIMEOUT_MS=60000
